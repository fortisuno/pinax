// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.pinax.desktop",
  "copyright": "Copyright © 2026 ${author}",
  "asar": true,
  "productName": "pinax",
  "executableName": "pinax",
  "afterPack": "scripts/adhoc-sign.cjs",
  "afterSign": "scripts/notarize.cjs",
  "directories": {
    "output": "../../release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    "category": "public.app-category.education",
    "icon": "public/pinax.icns",
    "darkModeSupport": true,
    // No paid Apple Developer ID in this repo: stay ad-hoc. hardenedRuntime
    // must remain false here — ad-hoc + hardened runtime produces a Gatekeeper
    // "damaged" rejection on downloaded builds. When a Developer ID cert is
    // added, flip to true and re-add:
    // "entitlements": "build/entitlements.mac.plist",
    // "entitlementsInherit": "build/entitlements.mac.plist",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "minimumSystemVersion": "11.0.0",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
    "extendInfo": {
      "NSHumanReadableCopyright": "Copyright © 2026 ${author}",
      "LSApplicationCategoryType": "public.app-category.education",
      "CFBundleDocumentTypes": []
    }
  },
  "dmg": {
    // NOTE: ${arch} is required in the title. electron-builder builds arch
    // targets concurrently and mounts each DMG at /Volumes/<title>; without
    // ${arch}, x64+arm64 builds share one mount point and corrupt each other
    // ("hdiutil detach ... No such file", or a DMG that `hdiutil verify`
    // rejects as "image not recognized").
    "title": "${productName}-${version}-${arch}",
    "icon": "public/pinax.icns",
    "iconSize": 96,
    "contents": [
      {
        "x": 130,
        "y": 220,
        "type": "file"
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/pinax.ico",
    "publisherName": "Pinax",
    "verifyUpdateCodeSignature": false,
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "${productName}-Windows-${version}-Portable.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Pinax"
  },
  "linux": {
    "target": [
      "AppImage",
      "zip"
    ],
    "desktop": {
      "StartupWMClass": "pinax"
    },
    "icon": "build/icons",
    "category": "Education",
    "synopsis": "Pinax Desktop - Gestión de criterios de evaluación",
    "description": "Aplicación de escritorio para gestión de criterios de evaluación.",
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
