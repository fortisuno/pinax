---
interface Props {
  size?: number;
  class?: string;
}

const { size = 96, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/svg"
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  class={className}
  aria-hidden="true"
>
  <rect
    x="0"
    y="0"
    width="1024"
    height="1024"
    rx="80"
    ry="80"
    fill="var(--foreground)"
  />
  <g transform="translate(512, 512)">
    <g transform="translate(-400, -400) scale(33.333)">
      <g
        fill="none"
        stroke="var(--background)"
        stroke-width="1.44"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 3v18a2 2 0 0 0 2 2h18"></path>
        <path d="M21 17V9"></path>
        <path d="M15 17V5"></path>
        <path d="M9 17v-3"></path>
      </g>
    </g>
  </g>
</svg>