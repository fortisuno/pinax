---
import Icon from "./Icon.astro";

const version = "0.1.13";
const baseUrl = `https://github.com/fortisuno/pinax/releases/download/v${version}`;
const repoHref = "https://github.com/fortisuno/pinax";

const linuxAppImage = `${baseUrl}/pinax-Linux-${version}.AppImage`;

const macArm64Dmg = `${baseUrl}/pinax-Mac-${version}-arm64.dmg`;
const macX64Dmg = `${baseUrl}/pinax-Mac-${version}-x64.dmg`;

const windowsSetup = `${baseUrl}/pinax-Windows-${version}-Setup.exe`;
---

<header
  class="relative px-6 pt-10 pb-24 md:px-12 md:pt-16 md:pb-32 lg:px-16 lg:pt-24"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between text-[0.82rem] uppercase tracking-[0.18em]"
  >
    <a
      href={import.meta.env.BASE_URL}
      class="inline-flex items-center gap-3 pinax-sans text-foreground"
      aria-label="Pinax Desktop"
    >
      <Icon size={28} class="shrink-0" />
      <span class="hidden sm:inline">Pinax Desktop</span>
    </a>
    <ul class="flex items-center gap-5 md:gap-7">
      <li>
        <a
          href={repoHref}
          class="text-muted-foreground hover:text-foreground transition-colors"
          target="_blank"
          rel="noopener"
          >Repositorio</a
        >
      </li>
      <li>
        <a
          href="#como-funciona"
          class="text-muted-foreground hover:text-foreground transition-colors"
          >Cómo funciona</a
        >
      </li>
      <li>
        <a
          id="nav-download"
          href={linuxAppImage}
          class="hidden md:inline-flex items-center gap-2 pinax-sans text-foreground hover:opacity-70 transition-opacity"
          target="_blank"
          rel="noopener"
        >
          <span>Descargar</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v14"></path>
            <path d="m6 11 6 6 6-6"></path>
            <path d="M5 21h14"></path>
          </svg>
        </a>
      </li>
    </ul>
  </nav>

  <div class="mx-auto max-w-3xl pt-20 md:pt-28 lg:pt-36 text-center">
    <div class="flex justify-center">
      <Icon size={120} class="md:scale-110 lg:scale-125" />
    </div>

    <h1
      class="mt-10 pinax-display text-[clamp(2.6rem,7vw,5rem)] leading-[1.04] text-foreground"
    >
      Pinax Desktop
    </h1>

    <p
      class="mt-7 mx-auto max-w-xl text-[1.06rem] md:text-[1.18rem] leading-[1.55] text-muted-foreground"
    >
      La app de cálculo de notas ponderadas para tu grupo de primaria. Tus
      tareas, tu rúbrica, tu nota final — en tu equipo, sin nube.
    </p>

    <div
      id="hero-download"
      data-linux={linuxAppImage}
      data-mac-arm={macArm64Dmg}
      data-mac-x64={macX64Dmg}
      data-windows={windowsSetup}
      class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-3"
    >
      <a
        id="hero-download-link"
        href={linuxAppImage}
        data-default-label="Descargar para Linux"
        class="group inline-flex items-center justify-center gap-3 rounded-md px-7 py-3 pinax-sans text-[0.96rem] font-medium bg-primary text-primary-foreground hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ring)] transition-opacity shadow-sm min-h-[3.25rem]"
        target="_blank"
        rel="noopener"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v14"></path>
          <path d="m6 11 6 6 6-6"></path>
          <path d="M5 21h14"></path>
        </svg>
        <span data-download-label>Descargar para Linux</span>
        <span class="opacity-70" aria-hidden="true">·</span>
        <span data-download-format class="opacity-90 pinax-mono text-[0.82rem]">.AppImage</span>
      </a>
    </div>

    <a
      href={repoHref}
      class="mt-8 inline-flex items-center gap-2 rounded-md px-4 py-3 pinax-sans text-[0.96rem] text-muted-foreground border border-border bg-card hover:text-foreground hover:bg-accent transition-colors"
      target="_blank"
      rel="noopener"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.94 10.94 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.07 0 4.4-2.68 5.36-5.24 5.65.41.35.78 1.05.78 2.11v3.13c0 .3.21.66.79.55 4.57-1.52 7.86-5.83 7.86-10.91C23.5 5.65 18.35.5 12 .5z"
        ></path>
      </svg>
      <span>Ver en GitHub</span>
    </a>

    <p class="mt-6 pinax-mono text-[0.78rem] text-muted-foreground">
      ¿Usas otro sistema? <a href="#descargar" class="underline underline-offset-4 hover:text-foreground transition-colors">Ver todas las opciones para Windows, macOS y Linux</a>
    </p>
    <p class="mt-2 pinax-mono text-[0.78rem] text-muted-foreground" aria-hidden="true">
      100% local, sin cuentas
    </p>
  </div>

  <script is:inline>
    (function () {
      function detectOS() {
        var ua = (navigator.userAgent || '').toLowerCase();
        var platform = (navigator.platform || '').toLowerCase();
        if (/mac|macintel|macppc|mac68k/i.test(platform)) return 'mac';
        if (/win32|win64|windows|wow64/i.test(platform)) return 'windows';
        if (/linux/i.test(platform)) return 'linux';
        if (/android/i.test(ua)) return 'linux';
        if (/iphone|ipad|ipod/i.test(ua)) return 'ios';
        return 'linux';
      }

      function applyDownload() {
        var container = document.getElementById('hero-download');
        var link = document.getElementById('hero-download-link');
        var navLink = document.getElementById('nav-download');
        if (!container || !link) return;

        var os = detectOS();
        var label = link.querySelector('[data-download-label]');
        var format = link.querySelector('[data-download-format]');

        var href = container.dataset.linux;
        var text = 'Descargar para Linux';
        var ext = '.AppImage';

        if (os === 'mac') {
          var ua = (navigator.userAgent || '').toLowerCase();
          var isIntel = /intel|x86_64|x64/.test(ua);
          href = isIntel ? container.dataset.macX64 : container.dataset.macArm;
          text = 'Descargar para macOS';
          ext = '.dmg';
        } else if (os === 'windows') {
          href = container.dataset.windows;
          text = 'Descargar para Windows';
          ext = '.exe';
        }

        if (href) {
          link.href = href;
          if (navLink) navLink.href = href;
        }
        if (label) label.textContent = text;
        if (format) format.textContent = ext;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyDownload);
      } else {
        applyDownload();
      }
    })();
  </script>
</header>